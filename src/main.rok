// playground.rok-lang.org: the page and its compile service.
//
//   POST /api/compile?opt=0|2   body: one rok source file (UTF-8, at most
//                               64 KiB). 200: the program as a
//                               wasm32-unknown-unknown module, or rokc's
//                               diagnostics as text with an
//                               `X-Rok-Diagnostics: 1` header; 400 / 413 /
//                               429 / 503 / 504 for the request itself.
//   POST /api/fmt               body: the same. 200: the source as
//                               `rokc fmt` lays it out, or its
//                               diagnostics (header as above).
//   POST /api/share             body: the same. 200: the id of a short
//                               link that holds the source, stored
//                               under PLAY_SHARES (never compiled or
//                               run here); 400 / 409 / 413 / 429 / 503.
//   GET  /api/share/<id>        the stored source, or 404
//   GET  /p/<id>                the page with that source in the editor
//   GET  /...                   static/, then the web kit's files
//                               (web/, built in), then PLAY_SITE, and
//                               /rok.mjs
//
// Each compile runs `rokc build --target=wasm32-unknown-unknown` in a
// fresh directory with a clean environment, under PLAY_WRAP (a sandbox
// command line such as bwrap's, see README.md), killed after
// PLAY_TIMEOUT seconds; `rokc fmt` the same way, under FMT_TIMEOUT.
// Finished modules are cached by the SHA-256 of
// level and source, so a shared link compiles once.
//
// Settings come from the environment:
//   PLAY_ADDR     127.0.0.1:8405    PLAY_ROKC    rokc
//   PLAY_SITE     ../rok-lang.org/static
//   PLAY_MJS      the toolchain's rok.mjs; by default, for a PLAY_ROKC
//                 path, <its dir>/../lib/rok/targets/wasm32-unknown-unknown/
//   PLAY_WRAP     ""                PLAY_WORK    <temp>/rok-playground
//   PLAY_JOBS     2                 PLAY_TIMEOUT 20
//   PLAY_RATE     30 (compiles per minute and client)
//   PLAY_SHARES   <PLAY_WORK>/shares: stored share links, one file each
//   PLAY_SHARE_RATE  10 (share links per minute and client)
//   PLAY_SHARE_MAX   100000 (links kept; past it, new ones are refused)
//   PLAY_CLIENT_HEADER  (none)  the header a trusted proxy sets with the
//                 real client IP, e.g. cf-connecting-ip behind Cloudflare
//                 or x-forwarded-for behind Caddy. Unset (the default),
//                 the TCP peer is the client, so a client cannot forge it.

use rok::std::env;
use rok::std::fs;
use rok::std::net;
use rok::std::net::TcpStream;
use rok::std::process::{Command, Stdio};
use rok::std::thread;
use rok::std::time::Duration;
use rok::core::crypto::HashAlgorithm;
use rok::std::time::SystemTime;
use rok::core::task::time::Instant;
use web::chrome;
use web::http;
use web::http::Request;
use web::kit;
use web::url;

const MAX_SOURCE: usize = 65536;
const MAX_CONNS: i64 = 64;
/// Cached modules kept; past it the cache starts over.
const MAX_CACHED: usize = 256;
/// The most diagnostics text a compile returns (bytes); past it, truncated.
const MAX_DIAG: usize = 65536;
/// The most a returned module may be (bytes); a 64 KiB source cannot
/// honestly produce more, so a larger output is refused.
const MAX_WASM: u64 = 33554432u64;
/// Seconds `rokc fmt` may take: it only lexes and re-indents.
const FMT_TIMEOUT: u64 = 5u64;
/// Characters of a share id: lowercase RFC 4648 base32, 10 of them.
const ID_CHARS: str = "abcdefghijklmnopqrstuvwxyz234567";
const ID_LEN: usize = 10;

static ACTIVE: Atomic<i64> = Atomic::new(0i64);
static JOBS: Atomic<i64> = Atomic::new(0i64);
static SEQ: Atomic<i64> = Atomic::new(0i64);
/// Share links stored, counted at start and on each new one.
static SHARES: Atomic<i64> = Atomic::new(0i64);

struct Cfg {
    addr: str;
    rokc: str;
    site: str;
    mjs: str;
    /// The sandbox command line, split at spaces when used (a `List`
    /// would not be `Sync`, and the config goes to every thread).
    wrap: str;
    work: str;
    jobs: i64;
    timeout: u64;
    rate: i64;
    client_header: str;
    shares: str;
    share_rate: i64;
    share_max: i64;
    /// The og:image version: the first 10 hex digits of og.png's SHA-256,
    /// put in place of index.html's `og.png?v=dev` when it is served.
    og: str;
}

fn setting(k: str, dflt: str) -> str {
    let v = try env::var(k) catch _ { "" };
    if v.is_empty() { dflt } else { v }
}

fn words(s: str) -> List<str> {
    let out: List<str> = List::new();
    for w in s.split_whitespace() { out.push(w); }
    out
}

/// The rok.mjs of the toolchain at `rokc` (a path): its wasm32 runtime's.
fn find_mjs(rokc: str) -> str {
    if let k: usize = rokc.rfind("/") { return rokc[:k] + "/../lib/rok/targets/wasm32-unknown-unknown/rok.mjs"; }
    ""
}

fn load_cfg() throws -> Cfg {
    let rokc = setting("PLAY_ROKC", "rokc");
    let mjs = setting("PLAY_MJS", find_mjs(rokc));
    let work = setting("PLAY_WORK", env::temp_dir().as_str() + "/rok-playground");
    let jobs = try setting("PLAY_JOBS", "2").parse::<i64>();
    let timeout = try setting("PLAY_TIMEOUT", "20").parse::<u64>();
    let rate = try setting("PLAY_RATE", "30").parse::<i64>();
    let share_rate = try setting("PLAY_SHARE_RATE", "10").parse::<i64>();
    let share_max = try setting("PLAY_SHARE_MAX", "100000").parse::<i64>();
    Cfg { addr: setting("PLAY_ADDR", "127.0.0.1:8405"), rokc: rokc, site: setting("PLAY_SITE", "../rok-lang.org/static"), mjs: mjs, wrap: try env::var("PLAY_WRAP") catch _ { "" }, work: work, jobs: jobs, timeout: timeout, rate: rate, client_header: setting("PLAY_CLIENT_HEADER", "").to_lowercase(), shares: setting("PLAY_SHARES", work + "/shares"), share_rate: share_rate, share_max: share_max, og: og_version(["static", setting("PLAY_SITE", "../rok-lang.org/static")]) }
}

/// The version of the og.png that `/og.png` serves from `roots`, or
/// `dev` without one.
fn og_version(roots: List<str>) -> str {
    for root in roots {
        let data = try fs::read(root + "/og.png") catch _ { continue; };
        return version(data);
    }
    "dev"
}

/// The first 10 hex digits of the SHA-256 of `data`: the `?v=` that
/// names this content.
fn version(data: List<u8>) -> str { hex(HashAlgorithm::Sha256.digest(data))[:10] }

fn bytes_of(s: str) -> List<u8> {
    let b: List<u8> = List::new();
    for x in s.as_bytes() { b.push(x); }
    b
}

// ---- answers ----

struct Resp {
    status: i32;
    headers: List<str>;
    body: List<u8>;
}

fn text(status: i32, msg: str) -> Resp {
    Resp { status: status, headers: ["Content-Type: text/plain; charset=utf-8", "Cache-Control: no-store"], body: bytes_of(msg) }
}

/// A program that does not compile is an answer, not a failed request:
/// 200, so the page's console stays clean, marked by its header.
fn diagnostics(msg: str) -> Resp {
    let r = text(200, msg);
    r.headers.push("X-Rok-Diagnostics: 1");
    r
}

fn hex(bytes: List<u8>) -> str {
    let digits = "0123456789abcdef";
    let out = StrBuf::new();
    for b in bytes {
        out.push_str(digits[(b >> 4u8) as usize:(b >> 4u8) as usize + 1]);
        out.push_str(digits[(b & 15u8) as usize:(b & 15u8) as usize + 1]);
    }
    out.to_str()
}

// ---- rate limit: per client, a window of one minute ----

struct Window {
    start: i64;
    count: i64;
}

static CLIENTS: Mutex<Dict<str, Window>> = Mutex::new(Dict::new());

fn now_secs() -> i64 { try SystemTime::now().unix_seconds() catch _ { 0i64 } }

fn allow(client: str, rate: i64) -> bool {
    using g = CLIENTS.lock() {
        let d = g.get();
        let t = now_secs();
        // Drop windows older than the minute so the table stays small,
        // without resetting everyone (which an attacker could force).
        if d.len() > 2048 {
            let keep: Dict<str, Window> = Dict::new();
            for (k, w) in d.entries() {
                if t - w.start < 60i64 { keep.insert(k, w); }
            }
            d = keep;
            g.set(d);
        }
        let w = d.get(client) ?? Window { start: t, count: 0i64 };
        if t - w.start >= 60i64 { w = Window { start: t, count: 0i64 }; }
        w.count += 1i64;
        d.insert(client, w);
        w.count <= rate
    }
}

/// The client: the proxy's X-Forwarded-For (its first address) or the peer.
/// The client for rate limiting. Without a trusted-proxy header the TCP
/// peer is used, so a client cannot forge its identity; a direct client's
/// own X-Forwarded-For is ignored. With one (PLAY_CLIENT_HEADER), its
/// value is trusted, taking the LAST entry of a list header, which is the
/// one the proxy appended (a client may prepend fakes, not append).
fn client_of(s: TcpStream, r: Request, header: str) -> str {
    if !header.is_empty() {
        let v = r.header(header);
        if !v.is_empty() {
            if let k: usize = v.rfind(",") { return v[k + 1:].trim(); }
            return v.trim();
        }
    }
    let a = try s.peer_addr() catch _ { return "?"; };
    let t = f"{a}";
    if let k: usize = t.rfind(":") { t[:k] } else { t }
}

// ---- compiling ----

/// What the playground does not compile: reading files at compile time
/// (`include_str!`, `include_bytes!`, `#[path]`, WIT imports) and raw
/// MLIR. The sandbox is what keeps the server's files out of reach; this
/// only says so plainly.
fn refused(src: str) -> str | none {
    for (word, what) in [("include_str", "include_str!"), ("include_bytes", "include_bytes!"), ("#[path", "#[path(..)]"),
        ("wit::import", "WIT imports"), ("wit::export", "WIT exports"), ("__mlir_op", "__mlir_op"), ("__mlir_attr", "__mlir_attr")] {
            if src.contains(word) {
                return f"error: the playground does not compile {what}: a program here is one file and reads nothing at compile time\n";
            }
        }
    none
}

/// rokc's diagnostics as the reader should see them: the work
/// directory's paths gone, the progress lines dropped.
fn tidy(err: str, dir: str) -> str {
    let out = StrBuf::new();
    for line in err.replace(dir + "/", "").lines() {
        let t = line.trim();
        if t.starts_with("Compiling ") || t.starts_with("Building ") || t.starts_with("Finished ") { continue; }
        out.push_str(line);
        out.push('\n');
    }
    out.to_str().trim_end() + "\n"
}

fn compile(cfg: Cfg, src: str, opt: str) -> Resp {
    let key = hex(HashAlgorithm::Sha256.digest((opt + "\n" + src).as_bytes()));
    let cached = cfg.work + "/cache/" + key + ".wasm";
    if fs::exists(cached) {
        let wasm = try fs::read(cached) catch _ { List::new() };
        if wasm.len() > 0 { return Resp { status: 200, headers: ["Content-Type: application/wasm", "Cache-Control: no-store", "X-Rok-Cache: hit"], body: wasm }; }
    }
    if JOBS.fetch_add(1i64) >= cfg.jobs {
        JOBS.fetch_sub(1i64);
        return text(503, "The compile server is busy; try again in a moment.");
    }
    let r = run_rokc(cfg, src, opt, key);
    JOBS.fetch_sub(1i64);
    r
}

fn run_rokc(cfg: Cfg, src: str, opt: str, key: str) -> Resp {
    let dir = f"{cfg.work}/jobs/{rok::std::process::id()}-{SEQ.fetch_add(1i64)}";
    try fs::create_dir_all(dir) catch e { return text(500, f"work directory: {e}"); };
    let resp = build_in(cfg, src, opt, key, dir);
    try fs::remove_dir_all(dir) catch _ {};
    resp
}

/// Runs `rokc <args>` in `dir` under the sandbox, its output in
/// `dir/rokc.log`: whether it succeeded, or the answer when it could not
/// run or took longer than `secs`.
fn run_tool(cfg: Cfg, dir: str, args: List<str>, secs: u64, what: str) -> bool | Resp {
    let log = try fs::create(dir + "/rokc.log") catch e { return text(500, f"work directory: {e}"); };
    let argv: List<str> = List::new();
    for w in words(cfg.wrap) { argv.push(w); }
    argv.push(cfg.rokc);
    for a in args { argv.push(a); }
    // A clean environment: no ROK_* / ROKC_* settings reach rokc, and
    // its home and caches are the job's own directory.
    let cmd = Command::new(argv[0]).args(argv[1:argv.len()].to_list()).current_dir(dir).env_clear()
        .env("PATH", "/usr/bin:/bin").env("HOME", dir).env("TMPDIR", dir).env("ROK_HOME", dir + "/.rok")
        .env("XDG_CACHE_HOME", dir + "/.cache").env("NO_COLOR", "1").env("ROKC_INCREMENTAL", "0")
        .stdin(Stdio::Null).stdout(Stdio::File(log)).stderr(Stdio::File(log)).kill_on_drop(true);
    let child = try cmd.spawn() catch e { return text(500, f"cannot start rokc: {e}"); };
    let t0 = Instant::now();
    let limit = (secs as i64) * 1000i64;
    loop {
        let st = try child.try_wait() catch e { return text(500, f"rokc: {e}"); };
        if let s: rok::std::process::ExitStatus = st { return s.success(); }
        if t0.elapsed().as_ms() > limit {
            try child.kill() catch _ {};
            try child.wait() catch _ {};
            return text(504, f"{what} took longer than {secs} s and was stopped.");
        }
        thread::sleep(Duration::ms(25));
    }
}

fn build_in(cfg: Cfg, src: str, opt: str, key: str, dir: str) -> Resp {
    try fs::write(dir + "/main.rok", src) catch e { return text(500, f"work directory: {e}"); };
    let ran = run_tool(cfg, dir, ["build", "--target=wasm32-unknown-unknown", "-O" + opt, "--target-dir", "t", "main.rok", "-o", "main.wasm"], cfg.timeout, "Compiling");
    if let r: Resp = ran { return r; }
    let ok = if let b: bool = ran { b } else { false };
    let err = try fs::read_to_str(dir + "/rokc.log") catch _ { "" };
    if !ok || !fs::exists(dir + "/main.wasm") {
        let diag = tidy(err, dir);
        return diagnostics(if diag.len() > MAX_DIAG { diag[:MAX_DIAG] + "\n... (truncated)\n" } else { diag });
    }
    let md = try fs::symlink_metadata(dir + "/main.wasm") catch e { return text(500, f"rokc output: {e}"); };
    // The compile runs as this same user in a writable job dir; never
    // follow a planted symlink, and never ship an implausibly large module.
    if !md.is_file() { return diagnostics("the build did not produce a module\n"); }
    if md.len() > MAX_WASM { return diagnostics("the module is too large\n"); }
    let wasm = try fs::read(dir + "/main.wasm") catch e { return text(500, f"rokc output: {e}"); };
    try fs::create_dir_all(cfg.work + "/cache") catch _ {};
    let n = 0usize;
    for _ in try fs::read_dir(cfg.work + "/cache") catch _ { return text(500, "cache directory"); } { n += 1; }
    if n >= MAX_CACHED { try fs::remove_dir_all(cfg.work + "/cache") catch _ {}; try fs::create_dir_all(cfg.work + "/cache") catch _ {}; }
    try fs::rename(dir + "/main.wasm", cfg.work + "/cache/" + key + ".wasm") catch _ {};
    Resp { status: 200, headers: ["Content-Type: application/wasm", "Cache-Control: no-store", "X-Rok-Cache: miss"], body: wasm }
}

/// `rokc fmt` on the source, in a job directory of its own: the source
/// laid out, or why not. rokc fmt only lexes the one file it is given,
/// but it runs sandboxed like a build all the same.
fn format(cfg: Cfg, src: str) -> Resp {
    if JOBS.fetch_add(1i64) >= cfg.jobs {
        JOBS.fetch_sub(1i64);
        return text(503, "The compile server is busy; try again in a moment.");
    }
    let dir = f"{cfg.work}/jobs/{rok::std::process::id()}-{SEQ.fetch_add(1i64)}";
    let r = format_in(cfg, src, dir);
    try fs::remove_dir_all(dir) catch _ {};
    JOBS.fetch_sub(1i64);
    r
}

fn format_in(cfg: Cfg, src: str, dir: str) -> Resp {
    try fs::create_dir_all(dir) catch e { return text(500, f"work directory: {e}"); };
    try fs::write(dir + "/main.rok", src) catch e { return text(500, f"work directory: {e}"); };
    let ran = run_tool(cfg, dir, ["fmt", "main.rok"], FMT_TIMEOUT, "Formatting");
    if let r: Resp = ran { return r; }
    let ok = if let b: bool = ran { b } else { false };
    if !ok {
        // rokc fmt names the file `<fmt>`; here it is main.rok.
        let err = (try fs::read_to_str(dir + "/rokc.log") catch _ { "" }).replace("<fmt>:", "main.rok:");
        let diag = tidy(err, dir);
        return diagnostics(if diag.len() > MAX_DIAG { diag[:MAX_DIAG] + "\n... (truncated)\n" } else { diag });
    }
    // Layout only re-indents, so the result is about the source's size;
    // never follow a planted symlink, never return much more.
    let md = try fs::symlink_metadata(dir + "/main.rok") catch e { return text(500, f"rokc output: {e}"); };
    if !md.is_file() || md.len() > (MAX_SOURCE * 4) as u64 { return diagnostics("rokc fmt did not leave a usable file\n"); }
    let out = try fs::read_to_str(dir + "/main.rok") catch e { return diagnostics(f"rokc fmt output: {e}\n"); };
    text(200, out)
}

// ---- share links: the source in a file named by its hash ----

/// The id of `src`: the first 50 bits of its SHA-256 in base32, so the
/// same code is always the same link.
fn share_id(src: str) -> str {
    let d = HashAlgorithm::Sha256.digest(src.as_bytes());
    let v = 0u64;
    for k in 0..8 { v = (v << 8u64) | (d[k] as u64); }
    let out = StrBuf::new();
    for k in 0..ID_LEN {
        let i = ((v >> (59u64 - 5u64 * (k as u64))) & 31u64) as usize;
        out.push_str(ID_CHARS[i:i + 1]);
    }
    out.to_str()
}

/// Whether `id` could be a share id; anything else never reaches the
/// file system.
fn valid_id(id: str) -> bool {
    if id.len() != ID_LEN { return false; }
    for c in id.chars() {
        if !ID_CHARS.contains(f"{c}") { return false; }
    }
    true
}

/// Store `src` and answer its id. An existing file is never rewritten:
/// the same id holds the same code, and a different code under it (a
/// hash collision) is refused, so the page falls back to a #code link.
fn share(cfg: Cfg, src: str) -> Resp {
    let id = share_id(src);
    let path = cfg.shares + "/" + id + ".rok";
    if fs::exists(path) {
        let old = try fs::read_to_str(path) catch _ { "" };
        return if old == src { text(200, id) } else { text(409, "Cannot make a short link for this code.") };
    }
    if SHARES.load() >= cfg.share_max { return text(503, "No room for new short links."); }
    try fs::create_dir_all(cfg.shares) catch e {
        eprintln(f"share: {e}");
        return text(500, "Cannot store the link.");
    };
    try fs::write_atomic(path, src) catch e {
        eprintln(f"share: {e}");
        return text(500, "Cannot store the link.");
    };
    SHARES.fetch_add(1i64);
    text(200, id)
}

/// The source stored under `id`, or none.
fn shared(cfg: Cfg, id: str) -> str | none {
    if !valid_id(id) { return none; }
    let path = cfg.shares + "/" + id + ".rok";
    let md = try fs::symlink_metadata(path) catch _ { return none; };
    if !md.is_file() || md.len() > MAX_SOURCE as u64 { return none; }
    try fs::read_to_str(path) catch _ { none }
}

fn count_shares(dir: str) -> i64 {
    let n = 0i64;
    for e in try fs::read_dir(dir) catch _ { return 0i64; } {
        let ent = try e.get() catch _ { continue; };
        if ent.file_name().ends_with(".rok") { n += 1i64; }
    }
    n
}

/// The page with a stored source in it: in a hidden <pre> the script
/// reads (the newline after <pre> is the one the parser drops), and kept
/// out of search results.
fn shared_page(cfg: Cfg, src: str) -> Resp | none {
    let r = page_resp(cfg, "static/index.html") ?? { return none; };
    let html = try str::from_utf8(r.body[0:r.body.len()]) catch _ { return none; };
    // index.html has one <title> and one <main>.
    r.body = bytes_of(html.replace("<title>", "<meta name=\"robots\" content=\"noindex\">\n<title>")
        .replace("<main ", f"<pre id=\"shared\" hidden>\n{chrome::esc(src)}</pre>\n<main "));
    r
}

// ---- routes ----

/// The page's own headers: scripts and workers from here only (and the
/// Cloudflare Web Analytics beacon the proxy injects), wasm compiled from
/// what the API returns, fonts from Google Fonts and jsDelivr. Style
/// attributes are allowed only because WebKit's own <select> shadow DOM
/// uses them; an attribute cannot hold a selector, and anything it loads
/// still meets img-src/font-src. <style> and stylesheets stay strict.
const CSP: str = "Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://static.cloudflareinsights.com; worker-src 'self'; style-src 'self' https://fonts.googleapis.com https://cdn.jsdelivr.net; style-src-attr 'unsafe-inline'; font-src 'self' https://fonts.gstatic.com https://cdn.jsdelivr.net; img-src 'self' data:; connect-src 'self' https://cloudflareinsights.com; object-src 'none'; base-uri 'none'; frame-ancestors 'none'";

fn file_resp(path: str) -> Resp | none {
    let data = try fs::read(path) catch _ { return none; };
    Resp { status: 200, headers: [f"Content-Type: {http::content_type(path)}", "Cache-Control: no-cache", CSP], body: data }
}

/// A file of the web kit, by its public path. `/theme-init.js` is the
/// name theme.js had here before the kit; cached pages still ask for it.
fn kit_resp(path: str) -> Resp | none {
    let name = if path == "/theme-init.js" { "theme.js" } else { path[1:] };
    let f = kit::find(kit::Mark::Rok, name) ?? { return none; };
    let b: List<u8> = List::new();
    for x in f.data { b.push(x); }
    Resp { status: 200, headers: [f"Content-Type: {http::content_type(name)}", "Cache-Control: no-cache", CSP], body: b }
}

/// The pages' shared markup, from the kit's chrome: each
/// `<!--web:name-->` placeholder replaced.
fn fill(html: str) -> str {
    let sites = chrome::Sites { home: "https://rok-lang.org", docs: "https://docs.rok-lang.org/latest", stones: "https://rokstones.io", playground: "/", current: "playground" };
    let lost = chrome::not_found("Page not found", "There is no page at this address.", [("/", "Back to the playground")]);
    html.replace("<!--web:theme-button-->", chrome::theme_button(false)).replace("<!--web:header-sites-->", chrome::header_sites(sites, false)).replace("<!--web:credits-->", f"<span>{chrome::LICENSE}</span> · {chrome::MADE_BY}").replace("<!--web:social-->", chrome::SOCIAL).replace("<!--web:theme-seg-->", chrome::theme_seg(false)).replace("<!--web:not-found-->", lost)
}

/// A page with the og:image version, the shared markup and the asset
/// versions filled in: a new og.png is a new URL, so link previews
/// refetch it.
fn page_resp(cfg: Cfg, path: str) -> Resp | none {
    let r = file_resp(path) ?? { return none; };
    if !path.ends_with(".html") { return r; }
    let html = try str::from_utf8(r.body[0:r.body.len()]) catch _ { return r; };
    r.body = bytes_of(stamp(cfg, fill(html.replace("og.png?v=dev", "og.png?v=" + cfg.og))));
    r
}

/// The stylesheets and scripts a page names, as `"/x?v=<version>"`, so
/// a browser keeps each until it changes.
fn stamp(cfg: Cfg, html: str) -> str {
    let out = html;
    for p in ["/rok.css", "/play.css", "/theme.js", "/play.js"] {
        if let x: Resp = asset(cfg, p) { out = out.replace(f"\"{p}\"", f"\"{p}?v={version(x.body)}\""); }
    }
    out
}

/// The file under `root` that canonical path `p` names, as a page.
fn site_file(cfg: Cfg, root: str, p: str) -> Resp | none {
    let f = http::page_file(root, p) ?? { return none; };
    page_resp(cfg, f)
}

/// The file at public path `p`: static/, then the kit, then PLAY_SITE.
fn asset(cfg: Cfg, p: str) -> Resp | none {
    site_file(cfg, "static", p) ?? kit_resp(p) ?? site_file(cfg, cfg.site, p)
}

/// Whether If-None-Match value `inm` names `etag`.
fn etag_match(inm: str, etag: str) -> bool {
    for t in inm.split(",") {
        let x = t.trim();
        if x == "*" || x == etag || x == "W/" + etag { return true; }
    }
    false
}

/// A file answer's caching: a page for five minutes, a file asked for by
/// its current `?v=` for a year, anything else revalidated each time;
/// always an ETag of the content, and 304 when the client holds it.
fn cached(x: Resp, page: bool, query: str, inm: str) -> Resp {
    let h = hex(HashAlgorithm::Sha256.digest(x.body));
    let etag = "\"" + h[:16] + "\"";
    let cc = "Cache-Control: no-cache";
    if page {
        cc = "Cache-Control: public, max-age=300";
    } else {
        for kv in query.split("&") {
            if kv == "v=" + h[:10] { cc = "Cache-Control: public, max-age=31536000, immutable"; }
        }
    }
    // headers[1] is file_resp's and kit_resp's Cache-Control.
    x.headers[1] = cc;
    x.headers.push("ETag: " + etag);
    if !inm.is_empty() && etag_match(inm, etag) { return Resp { status: 304, headers: [cc, "ETag: " + etag], body: List::new() }; }
    x
}

fn route(cfg: Cfg, s: TcpStream, r: Request) -> Resp {
    let p = r.path;
    if p == "/api/compile" {
        if r.method != "POST" { return text(405, "POST the source to /api/compile."); }
        if !allow(client_of(s, r, cfg.client_header), cfg.rate) { return text(429, f"More than {cfg.rate} compiles a minute; wait a little."); }
        let opt = if r.query.contains("opt=2") { "2" } else { "0" };
        if r.body.trim().is_empty() { return text(400, "Nothing to compile."); }
        if let why: str = refused(r.body) { return diagnostics(why); }
        return compile(cfg, r.body, opt);
    }
    if p == "/api/fmt" {
        if r.method != "POST" { return text(405, "POST the source to /api/fmt."); }
        if !allow(client_of(s, r, cfg.client_header), cfg.rate) { return text(429, f"More than {cfg.rate} requests a minute; wait a little."); }
        if r.body.trim().is_empty() { return text(400, "Nothing to format."); }
        return format(cfg, r.body);
    }
    if p == "/api/share" {
        if r.method != "POST" { return text(405, "POST the source to /api/share."); }
        // Its own budget, apart from compiles.
        if !allow("share " + client_of(s, r, cfg.client_header), cfg.share_rate) { return text(429, f"More than {cfg.share_rate} links a minute; wait a little."); }
        if r.body.trim().is_empty() { return text(400, "Nothing to share."); }
        return share(cfg, r.body);
    }
    if r.method != "GET" && r.method != "HEAD" { return text(405, "Only GET here."); }
    if p.starts_with("/api/share/") {
        let src = shared(cfg, p["/api/share/".len():]) ?? { return text(404, "No such link."); };
        return text(200, src);
    }
    let inm = r.header("if-none-match");
    if p == "/rok.mjs" && !cfg.mjs.is_empty() {
        if let f: Resp = file_resp(cfg.mjs) { return cached(f, false, r.query, inm); }
    }
    if let c: str = url::canonical(p) {
        return Resp { status: 301, headers: [url::moved(c, r.query), "Cache-Control: public, max-age=3600"], body: List::new() };
    }
    if p.starts_with("/p/") {
        let src = shared(cfg, p[3:]) ?? { return not_found(cfg, p); };
        let x = shared_page(cfg, src) ?? { return not_found(cfg, p); };
        return cached(x, true, r.query, inm);
    }
    if let x: Resp = asset(cfg, p) { return cached(x, x.headers[0].starts_with("Content-Type: text/html"), r.query, inm); }
    not_found(cfg, p)
}

/// 404: the page with the site's chrome, or plain text under /api/.
fn not_found(cfg: Cfg, p: str) -> Resp {
    if !p.starts_with("/api/") {
        if let x: Resp = page_resp(cfg, "static/404.html") {
            x.status = 404;
            return x;
        }
    }
    text(404, "Not found.")
}

/// 304 by hand: http::send would add `Content-Length: 0`, which is not
/// the length of the representation the client holds.
fn not_modified(s: TcpStream, headers: List<str>) throws {
    let h = StrBuf::new();
    h.push_str("HTTP/1.1 304 Not Modified\r\n");
    for x in headers { h.push_str(x + "\r\n"); }
    h.push_str("Connection: close\r\n\r\n");
    try s.set_write_timeout(Duration::sec(30));
    try s.write_all(h.to_str());
}

fn handle(s: TcpStream, cfg: Cfg) {
    let t0 = Instant::now();
    let r = try http::read_request(s, MAX_SOURCE, Duration::sec(10)) catch e {
        try http::send(s, e.status, ["Content-Type: text/plain; charset=utf-8"], e.msg + "\n", false) catch _ {};
        s.close();
        return;
    };
    let resp = route(cfg, s, r);
    if resp.status == 304 { try not_modified(s, resp.headers) catch _ {}; }
    else { try http::send(s, resp.status, resp.headers, resp.body, r.method == "HEAD") catch _ {}; }
    s.close();
    eprintln(f"{r.method} {r.path} {resp.status} {resp.body.len()}B {t0.elapsed().as_ms()}ms");
}

fn main() throws {
    let cfg = try load_cfg();
    // Without a sandbox a program could read the server's files at
    // compile time: only this machine may ask then.
    if cfg.wrap.is_empty() && !cfg.addr.starts_with("127.0.0.1:") && !cfg.addr.starts_with("[::1]:") && !cfg.addr.starts_with("localhost:") {
        eprintln(f"error: PLAY_ADDR={cfg.addr} is reachable from other machines, so PLAY_WRAP must name a sandbox (scripts/sandbox.sh, see README.md)");
        env::exit(2);
    }
    try fs::create_dir_all(cfg.work + "/jobs");
    // Without a writable share directory, Share falls back to #code links.
    try fs::create_dir_all(cfg.shares) catch e { eprintln(f"note: share links off: {cfg.shares}: {e}"); };
    SHARES.store(count_shares(cfg.shares));
    if cfg.mjs.is_empty() || !fs::exists(cfg.mjs) {
        eprintln(f"note: no rok.mjs (PLAY_MJS): pages cannot run programs");
    }
    using l = try net::tcp_listen(cfg.addr) {
        eprintln(f"playground on http://{cfg.addr}, compiling with {cfg.rokc} ({cfg.jobs} at a time, {cfg.timeout} s each)");
        for c in l.incoming() {
            let s = try c.get() catch e {
                eprintln(f"accept: {e}");
                continue;
            };
            if ACTIVE.fetch_add(1i64) >= MAX_CONNS {
                ACTIVE.fetch_sub(1i64);
                try http::send(s, 503, ["Content-Type: text/plain; charset=utf-8"], "busy\n", false) catch _ {};
                s.close();
                continue;
            }
            let t = thread::spawn(|| {
                handle(s, cfg);
                ACTIVE.fetch_sub(1i64);
                0
            });
            t.detach();
        }
    }
}

#[cfg(test)]
fn expect(ok: bool, what: str) {
    if !ok { panic(what); }
}

#[cfg(test)]
fn body_of(r: Resp) -> str { try str::from_utf8(r.body[0:r.body.len()]) catch _ { "" } }

/// A failed compile answers 200 with the diagnostics and their header;
/// a 4xx would log a failed request in every visitor's console.
#[test]
fn compile_errors_are_answers() {
    let work = f"{env::temp_dir()}/rok-playground-test-{rok::std::process::id()}";
    try fs::create_dir_all(work + "/jobs") catch e { panic(f"{e}"); };
    // A stand-in rokc, run by the wrap command so it needs no exec bit.
    try fs::write(work + "/rokc.sh", "echo 'error: boom' >&2\nexit 1\n") catch e { panic(f"{e}"); };
    let cfg = Cfg { addr: "127.0.0.1:0", rokc: work + "/rokc.sh", site: "", mjs: "", wrap: "/bin/sh", work: work, jobs: 1, timeout: 20u64, rate: 30, client_header: "", shares: work + "/shares", share_rate: 10, share_max: 2, og: "0123456789" };
    let r = compile(cfg, "fn main() {}\n", "0");
    try fs::remove_dir_all(work) catch _ {};
    expect(r.status == 200, "status");
    expect(r.headers.contains("X-Rok-Diagnostics: 1"), "header");
    expect(body_of(r).contains("error: boom"), "body");

    let no = diagnostics(refused("const S: str = include_str!(\"/etc/passwd\");") ?? "");
    expect(no.status == 200 && no.headers.contains("X-Rok-Diagnostics: 1"), "refused");
    expect(body_of(no).contains("include_str!"), "refused body");
    expect(text(429, "slow down").headers.len() == 2, "real errors keep their status, no header");

    let page = page_resp(cfg, "static/index.html") ?? panic("no index.html");
    expect(body_of(page).contains("og.png?v=0123456789") && !body_of(page).contains("v=dev"), "og version in page");
    expect(!body_of(page).contains("<!--web:"), "shared markup filled in");
    expect(body_of(page).contains("data-theme-set=\"dark\"") && body_of(page).contains("<a href=\"/\" aria-current=\"page\">Playground</a>"), "footer");
    let css = kit_resp("/rok.css") ?? panic("no /rok.css");
    expect(css.headers[0] == "Content-Type: text/css; charset=utf-8" && css.body.len() > 0, "kit file");
    expect(kit_resp("/theme-init.js") is Resp && kit_resp("/play.js") is none, "kit names only");
    expect(body_of(page).contains("class=\"seg\"") && body_of(page).contains("class=\"social\""), "menu");
    expect(body_of(page).contains("<nav class=\"nav sites\"") && body_of(page).contains("<span>MIT OR Apache-2.0</span> · <span>Made by"), "header sites, credits");

    let lost = not_found(cfg, "/nope");
    expect(lost.status == 404 && body_of(lost).contains("Back to the playground") && body_of(lost).contains("<div class=\"lost\">") && !body_of(lost).contains("<!--web:"), "404 page");
    expect(not_found(cfg, "/api/nope").status == 404 && body_of(not_found(cfg, "/api/nope")) == "Not found.", "404 api");
    expect(body_of(page).contains("<h1 class=\"sr-only\">Rok Playground</h1>"), "h1");
}

/// Files carry an ETag and answer 304 for it; a file asked for by its
/// current ?v= is cached for good, a page for minutes, the rest revalidated.
#[test]
fn caching() {
    let cfg = Cfg { addr: "127.0.0.1:0", rokc: "", site: "", mjs: "", wrap: "", work: "", jobs: 1, timeout: 20u64, rate: 30, client_header: "", shares: "", share_rate: 10, share_max: 2, og: "dev" };
    let page = page_resp(cfg, "static/index.html") ?? panic("no index.html");
    let js = asset(cfg, "/play.js") ?? panic("no play.js");
    let v = version(js.body);
    expect(body_of(page).contains(f"src=\"/play.js?v={v}\""), "stamped play.js");
    expect(!body_of(page).contains("href=\"/rok.css\"") && !body_of(page).contains("href=\"/play.css\"") && !body_of(page).contains("src=\"/theme.js\""), "stamped css, theme.js");
    let c = cached(asset(cfg, "/play.js") ?? panic("js"), false, f"v={v}", "");
    expect(c.status == 200 && c.headers.contains("Cache-Control: public, max-age=31536000, immutable"), "immutable");
    let etag = c.headers[c.headers.len() - 1];
    expect(etag.starts_with("ETag: \"") && etag.len() == 24, "etag");
    let stale = cached(asset(cfg, "/play.js") ?? panic("js"), false, "v=0000000000", "");
    expect(stale.headers.contains("Cache-Control: no-cache"), "stale version revalidates");
    let p = cached(page, true, "", "");
    expect(p.headers.contains("Cache-Control: public, max-age=300"), "page");
    let tag = etag["ETag: ".len():];
    let again = cached(asset(cfg, "/play.js") ?? panic("js"), false, "", "W/" + tag + ", \"x\"");
    expect(again.status == 304 && again.body.len() == 0 && again.headers.contains("ETag: " + tag), "304");
    expect(cached(asset(cfg, "/play.js") ?? panic("js"), false, "", "\"nope\"").status == 200, "other etag");
}

/// Share links: content-addressed, never rewritten, strict ids, a cap.
#[test]
fn share_links() {
    let work = f"{env::temp_dir()}/rok-playground-share-{rok::std::process::id()}";
    let cfg = Cfg { addr: "127.0.0.1:0", rokc: "", site: "", mjs: "", wrap: "", work: work, jobs: 1, timeout: 20u64, rate: 30, client_header: "", shares: work + "/shares", share_rate: 10, share_max: 2, og: "dev" };
    SHARES.store(0i64);
    let a = share(cfg, "fn main() {}\n");
    let id = body_of(a);
    expect(a.status == 200 && valid_id(id) && id == share_id("fn main() {}\n"), "stored");
    expect(body_of(share(cfg, "fn main() {}\n")) == id && SHARES.load() == 1i64, "same code, same id, one file");
    expect((shared(cfg, id) ?? "") == "fn main() {}\n", "read back");
    expect(shared(cfg, "../shares/" + id) is none && shared(cfg, id + "x") is none && shared(cfg, "ABCDEFGHIJ") is none && shared(cfg, "abcdefgh1j") is none, "bad ids");
    expect(shared(cfg, "aaaaaaaaaa") is none, "unknown id");
    let x = shared_page(cfg, "</pre><script>alert(1)</script>") ?? panic("page");
    expect(body_of(x).contains("<pre id=\"shared\" hidden>\n&lt;/pre&gt;&lt;script&gt;") && body_of(x).contains("noindex"), "escaped in the page");
    // A different code under an existing id is refused, not overwritten.
    try fs::write(cfg.shares + "/" + share_id("x") + ".rok", "y") catch e { panic(f"{e}"); };
    expect(share(cfg, "x").status == 409 && (shared(cfg, share_id("x")) ?? "") == "y", "collision");
    expect(share(cfg, "fn other() {}\n").status == 200 && share(cfg, "fn third() {}\n").status == 503, "cap");
    expect(count_shares(cfg.shares) == 3i64, "count");
    try fs::remove_dir_all(work) catch _ {};
}

/// Format answers the file rokc fmt left, or its diagnostics.
#[test]
fn format_answers() {
    let work = f"{env::temp_dir()}/rok-playground-fmt-{rok::std::process::id()}";
    try fs::create_dir_all(work + "/jobs") catch e { panic(f"{e}"); };
    try fs::write(work + "/ok.sh", "printf 'fn main() {\\n    f();\\n}\\n' > main.rok\n") catch e { panic(f"{e}"); };
    try fs::write(work + "/bad.sh", "echo 'error[E001]: <fmt>:2:1: unterminated string literal' >&2\nexit 1\n") catch e { panic(f"{e}"); };
    let cfg = Cfg { addr: "127.0.0.1:0", rokc: work + "/ok.sh", site: "", mjs: "", wrap: "/bin/sh", work: work, jobs: 1, timeout: 20u64, rate: 30, client_header: "", shares: work + "/shares", share_rate: 10, share_max: 2, og: "dev" };
    let ok = format(cfg, "fn main() {\nf();\n}\n");
    cfg.rokc = work + "/bad.sh";
    let bad = format(cfg, "fn main() {\n\"\n");
    try fs::remove_dir_all(work) catch _ {};
    expect(ok.status == 200 && !ok.headers.contains("X-Rok-Diagnostics: 1") && body_of(ok) == "fn main() {\n    f();\n}\n", "formatted");
    expect(bad.status == 200 && bad.headers.contains("X-Rok-Diagnostics: 1") && body_of(bad).contains("main.rok:2:1"), "fmt diagnostics");
}
