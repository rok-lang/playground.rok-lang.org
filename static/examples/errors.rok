// Errors are in a function's
// type: `throws (E)`. The caller
// writes `try` to pass them on,
// or `catch` to handle them.

fn parse_port(s: str) throws (ParseError) -> u16 {
    try s.parse::<u16>()
}

fn main() {
    for s in ["8080", "80x", "70000"] {
        let port = try parse_port(s) catch e {
            println(f"{s}: {e}");
            continue;
        };
        println(f"{s}: port {port}");
    }
}
